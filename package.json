		"vite": "^5.4.0",
		"vitest": "^3.0.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/bebas-neue": "^5.0.18",
		"@fontsource/jetbrains-mono": "^5.0.18",
		"@fontsource/manrope": "^5.0.18",
		"lucide-svelte": "^0.469.0",
		"open-props": "^1.6.16",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0",
		"remark-unwrap-images": "^4.0.0",
		"shiki": "^1.0.0"
